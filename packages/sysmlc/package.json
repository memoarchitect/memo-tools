{
  "name": "@memoarchitect/sysmlc",
  "version": "0.7.1",
  "description": "sysmlc — MEMO's SysML v2 compiler as a tool: one-shot check/emit-ir, or an LSP server over stdio",
  "type": "module",
  "bin": {
    "sysmlc": "./lib/bin/sysmlc.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm clean && pnpm build",
    "clean": "rm -rf lib",
    "type-check": "tsc --noEmit"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@memoarchitect/tools": "0.7.1",
    "commander": "^12.1.0",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memoarchitect/memo-tools.git",
    "directory": "packages/sysmlc"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
